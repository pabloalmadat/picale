# ── PÍCALE AI · copia este archivo como .env y llena los valores ──

# Misma base de datos del API actual (las tablas nuevas empiezan con ai_)
DATABASE_URL=postgresql://USUARIO:CLAVE@picale-db:5432/NOMBRE_DB

# API actual (dentro de la red de Docker). Solo se usa para validar el login.
MAIN_API_URL=http://picale-api:8080

# URL pública de este servicio
PUBLIC_BASE=https://api.picalereplay.com/ai

# Llaves: genera cada una con   openssl rand -hex 24
EDGE_KEYS=somos:PEGA-LLAVE-DE-SOMOS
ADMIN_KEY=PEGA-LLAVE-ADMIN
WORKER_KEY=PEGA-LLAVE-WORKER

# Análisis en Modal (opcional). Vacío = el partido espera a un worker que lo pida.
MODAL_URL=

# Resumen tipo coach (opcional). Vacío = no se escribe resumen.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Precios que muestra la web (MXN). null = sin precio visible.
PRODUCTS_JSON=[{"id":"picale_token_1","label":"1 token","credits":1,"price_mxn":null},{"id":"picale_token_5","label":"5 tokens","credits":5,"price_mxn":null},{"id":"picale_token_10","label":"10 tokens · paquete coach","credits":10,"price_mxn":null}]

# Video completo: días que se guarda (los clips se quedan). Mejores puntos que se cortan solos.
RETENTION_DAYS=30
AUTO_CLIPS=5
